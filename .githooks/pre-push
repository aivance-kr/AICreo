#!/bin/sh
#
# push 직전 대상 브랜치별로 검증 정책을 적용합니다.
#   · main       : 직접 push 차단 — 배포는 dev → main PR(merge commit)로만.
#   · 그 외 브랜치 : 품질 게이트(composer ci = cs · analyse · test) 필수.
#                    feature → dev 는 GitHub Squash merge 로 처리돼 CI 가 돌지 않으므로,
#                    이 훅이 dev 진입 전 유일한 검증 지점이다 — feature/* 라고 건너뛰지 않는다.
#                    단, 문서 전용 변경(*.md, docs/**, .claude/rules/**)은 자동으로 건너뛴다.
#
# 활성화: 저장소 루트에서 `git config core.hooksPath .githooks`
# 건너뛰기: `SKIP_HOOKS=1 git push ...` (또는 `git push --no-verify`) — main 차단은 우회되지 않는다.

ZERO_SHA="0000000000000000000000000000000000000000"

# range 내 변경 파일이 전부 문서(*.md, docs/**, .claude/rules/**)면 0(참)을 반환한다.
is_docs_only() {
    range="$1"
    changed="$(git diff --name-only "$range" 2>/dev/null)"
    [ -z "$changed" ] && return 1
    echo "$changed" | grep -qvE '\.md$|^docs/|^\.claude/rules/' && return 1
    return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue

    branch="${remote_ref#refs/heads/}"

    if [ "$branch" = "main" ]; then
        echo "✖ main 직접 push 는 차단됩니다 — dev → main PR(merge commit)로만 배포하세요."
        exit 1
    fi

    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        range="origin/dev...$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    if is_docs_only "$range"; then
        echo "▶ [$branch] 문서 전용 변경 감지 — 품질 게이트를 건너뜁니다."
        continue
    fi

    if [ -n "$SKIP_HOOKS" ]; then
        echo "⚠ SKIP_HOOKS=1 — [$branch] 품질 게이트를 건너뜁니다."
        continue
    fi

    # composer 미설치 환경에서는 훅을 건너뛴다(이번 push는 통과).
    if ! command -v composer >/dev/null 2>&1; then
        echo "⚠ composer 를 찾을 수 없어 품질 게이트를 건너뜁니다. (이번 push 는 통과)"
        continue
    fi

    # 의존성 미설치 시에도 통과시키되 안내한다.
    if [ ! -d "./vendor" ]; then
        echo "⚠ vendor/ 가 없습니다. 'composer install' 후 다시 시도하세요. (이번 push 는 통과)"
        continue
    fi

    echo "▶ [$branch] 품질 게이트 실행 중 (composer ci: cs · analyse · test)..."

    composer ci
    STATUS=$?

    if [ "$STATUS" -ne 0 ]; then
        echo ""
        echo "✖ 품질 게이트 실패 — push 를 중단합니다."
        echo "  · 스타일 오류면: composer cs:fix"
        echo "  · 정적분석/테스트 오류면: 로그를 확인해 수정 후 다시 push"
        echo "  · 부득이하게 건너뛰려면: SKIP_HOOKS=1 git push ... (또는 git push --no-verify)"
        exit 1
    fi

    echo "✔ [$branch] 품질 게이트 통과 — push 를 진행합니다."
done

exit 0

#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL 은 반드시 설정해야 한다 — CI4 는 이 값이 없거나 빈 문자열이면
# 유효한 URL 이 아니라며 예외를 던진다(자동 감지하지 않는다). 아래 값은 이
# 저장소가 문서화한 로컬 Caddy 주소(`http://creo.test/`)에 맞춘 기본값이다 —
# 운영 배포 시에는 반드시 실제 도메인으로 바꿔야 한다.
app.baseURL = 'http://creo.test/'
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# SEO / GEO
#--------------------------------------------------------------------
# IndexNow 즉시 색인 제출용 키(32~64자 랜덤 16진). 설정 시 활성, 로컬 도메인은 제출 안 함.
# 키 검증 파일: https://{도메인}/indexnow-key.txt
# INDEXNOW_KEY = ''

# 글별 OG 썸네일(GD)에 쓸 한글 TTF/TTC 경로. 비워 두면 시스템 Noto CJK·나눔고딕을 찾고,
# 폰트가 없으면 사이트 공통 OG 이미지를 쓴다.
# OG_FONT_PATH = ''

